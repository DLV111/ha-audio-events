{
  "name": "HA Audio Events",
  "slug": "ha_audio_events",
  "version": "0.1.2",
  "description": "Home Assistant add-on for audio event detection using TensorFlow Lite.",
  "arch": ["amd64", "armv7", "armhf", "aarch64"],
  "startup": "application",
  "boot": "auto",
  "host_network": false,
  "map": [
    {"config": "/config"},
    {"addons": "/addons"},
    {"ssl": "/ssl"}
  ],
  "options": {
    "model": "yamnet",
    "buffer_seconds": 3.0,
    "audio": {
      "sample_rate": 16000,
      "channels": 1,
      "format": "pcm_s16le"
    },
    "activity": {
      "rms_threshold": 0.04,
      "peak_threshold": 0.1,
      "hold_time": 2.0
    },
    "classifier": {
      "threshold": 0.8,
      "max_results": 5,
      "include": ["train", "dog", "thunder", "siren", "speech"],
      "exclude": ["music", "silence"]
    },
    "aggregation": {
      "start_confidence": 0.85,
      "end_timeout": 5.0
    },
    "homeassistant": {
      "enabled": true,
      "url": "http://supervisor/homeassistant",
      "token": null,
      "entity_prefix": "audio"
    },
    "mqtt": {
      "enabled": false,
      "host": "localhost",
      "port": 1883,
      "topic": "audio/events",
      "discovery_prefix": "homeassistant"
    }
  },
  "schema": {
    "type": "object",
    "properties": {
      "model": {"type": "string"},
      "buffer_seconds": {"type": "number"},
      "audio": {
        "type": "object",
        "properties": {
          "sample_rate": {"type": "integer"},
          "channels": {"type": "integer"},
          "format": {"type": "string"}
        },
        "additionalProperties": false
      },
      "activity": {
        "type": "object",
        "properties": {
          "rms_threshold": {"type": "number"},
          "peak_threshold": {"type": "number"},
          "hold_time": {"type": "number"}
        },
        "additionalProperties": false
      },
      "classifier": {
        "type": "object",
        "properties": {
          "threshold": {"type": "number"},
          "max_results": {"type": "integer"},
          "include": {"type": "array", "items": {"type": "string"}},
          "exclude": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      },
      "aggregation": {
        "type": "object",
        "properties": {
          "start_confidence": {"type": "number"},
          "end_timeout": {"type": "number"}
        },
        "additionalProperties": false
      },
      "homeassistant": {
        "type": "object",
        "properties": {
          "enabled": {"type": "boolean"},
          "url": {"type": "string"},
          "token": {"type": ["string", "null"]},
          "entity_prefix": {"type": "string"}
        },
        "additionalProperties": false
      },
      "mqtt": {
        "type": "object",
        "properties": {
          "enabled": {"type": "boolean"},
          "host": {"type": "string"},
          "port": {"type": "integer"},
          "topic": {"type": "string"},
          "discovery_prefix": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "ports": {"1883": 1883},
  "logger": "info"
}
